{
  "name": "dotoriwiki",
  "version": "0.1.0",
  "description": "Memos from your phone, filed into a git wiki by Claude Code on your own computer.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "dotoriwiki": "dist/cli.js"
  },
  "files": [
    "dist",
    "presets"
  ],
  "engines": {
    "node": ">=24.22"
  },
  "scripts": {
    "start": "node src/cli.ts start",
    "dotoriwiki": "node src/cli.ts",
    "check": "tsc --noEmit -p .",
    "test": "tsc --noEmit -p . && node --test test/*.test.ts",
    "e2e": "node scripts/e2e.ts",
    "e2e:collect": "node scripts/e2e-collect.ts",
    "confinement": "node scripts/confinement.ts",
    "check:private": "node scripts/check-private.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "check:pack": "node scripts/pack-check.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@mozilla/readability": "^0.6.0",
    "exifr": "7.1.3",
    "linkedom": "^0.18.14",
    "qrcode": "^1.5.4",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "typescript": "^7.0.2"
  }
}
